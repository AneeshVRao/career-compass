# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# The Supabase URL and publishable key are duplicated on purpose. Vite only
# inlines `VITE_`-prefixed vars into the client bundle, while the SSR/server
# side reads the unprefixed ones from the process environment. Both halves of
# the app need the same values, so both spellings have to be set.

# --- Supabase: client bundle (inlined at build time, safe to expose) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Supabase: server side (SSR fallback, same values as above) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Supabase: service role. BYPASSES RLS. Server-only, never `VITE_`-prefixed ---
# Prefixing this with VITE_ would inline it into the browser bundle and hand
# every visitor full database access. Don't.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Email delivery (Resend) ---
# Only needed to actually send reminders; the rest of the app runs without it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- Reminder cron shared secret ---
# Guards POST /api/public/run-reminders. Must match the `reminder_cron_secret`
# row in the `private.app_secrets` table that the pg_cron job reads from.
# Generate one with:  openssl rand -hex 32
REMINDER_CRON_SECRET=
